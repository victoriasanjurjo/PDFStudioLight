<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudioLight.Views.SignPdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Firmar Digitalmente" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Dibuja tu firma a mano alzada o carga una firma gráfica para estamparla en tus documentos."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de opciones y documento -->
            <StackPanel Grid.Column="0" Spacing="16">
                <!-- PDF de Destino -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Documento a Firmar" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PdfFileName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <Button Content="Seleccionar PDF" Command="{x:Bind ViewModel.SelectPdfCommand}" />
                        <NumberBox Header="Página para la firma" Value="{x:Bind ViewModel.TargetPage, Mode=TwoWay}"
                                   Minimum="1" Maximum="{x:Bind ViewModel.MaxPages, Mode=OneWay}" SpinButtonPlacementMode="Inline" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Herramientas de trazo -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Opciones de Tinta" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Slider Header="Grosor del Trazo" Minimum="1" Maximum="10" Value="{x:Bind ViewModel.StrokeThickness, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnColorBlack" Content="Negro" Click="OnColorBlackClick" />
                            <Button x:Name="BtnColorBlue" Content="Azul" Click="OnColorBlueClick" />
                            <Button x:Name="BtnColorRed" Content="Rojo" Click="OnColorRedClick" />
                            <Button Content="Limpiar Pizarra" Click="OnClearCanvasClick" />
                        </StackPanel>
                        <Button Content="Cargar Firma Existente (PNG)" Command="{x:Bind ViewModel.LoadExistingSignatureCommand}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Acciones -->
                <StackPanel Spacing="10">
                    <Button Content="Exportar Firma como PNG Transparente" Click="OnExportPngClick" HorizontalAlignment="Stretch" />
                    <Button Content="Estampar Firma en Documento PDF" Click="OnStampToPdfClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>

            <!-- Pizarra de Dibujo -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Pizarra interactiva de firma (Dibuja con el puntero del mouse o lápiz táctil)"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- Lienzo de firma -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="2" CornerRadius="6" x:Name="CanvasContainer">
                        <Canvas x:Name="SignatureCanvas" Background="Transparent"
                                PointerPressed="OnCanvasPointerPressed"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerReleased="OnCanvasPointerReleased" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Estado -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

