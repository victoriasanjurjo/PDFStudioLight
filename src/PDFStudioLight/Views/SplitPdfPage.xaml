<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudioLight.Views.SplitPdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Separar / Extraer PDF" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Divide un documento en páginas individuales o extrae bloques específicos de páginas."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Selector de archivo -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="Seleccionar PDF" Command="{x:Bind ViewModel.SelectFileCommand}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Opciones de división -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="Método de División" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <RadioButton Content="Dividir en páginas individuales (un archivo por cada página)"
                             IsChecked="{x:Bind ViewModel.SplitAllPages, Mode=TwoWay}" />

                <StackPanel Spacing="8">
                    <RadioButton Content="Extraer por rangos personalizados de páginas"
                                 IsChecked="{x:Bind ViewModel.SplitAllPages, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}" />
                    <TextBox Header="Rangos de páginas (separados por comas)"
                             PlaceholderText="Ejemplo: 1-3, 5, 8-10"
                             Text="{x:Bind ViewModel.CustomRanges, Mode=TwoWay}"
                             Margin="24,0,0,0" />
                    <TextBlock Text="💡 Ejemplo: '1-3, 5' creará un PDF con las páginas 1 a 3 y otro PDF con la página 5."
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="24,0,0,0" />
                </StackPanel>

                <!-- Carpeta de destino -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Carpeta de Destino" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Explorar..." Command="{x:Bind ViewModel.SelectOutputFolderCommand}" />
                    </Grid>
                </StackPanel>

                <Button Content="Ejecutar Separación"
                        Command="{x:Bind ViewModel.ExecuteSplitCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}"
                        Padding="24,10" />
            </StackPanel>
        </Border>

        <!-- Estado -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
