<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudioLight.Views.EditPdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PDFStudioLight.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Editar PDF" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Visualiza las páginas, rota su orientación o elimina páginas no deseadas."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Barra de herramientas -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton Icon="OpenFile" Label="Abrir PDF" Command="{x:Bind ViewModel.OpenFileCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Rotate" Label="Rotar 90° Derecha" Command="{x:Bind ViewModel.RotateRightCommand}" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
            <AppBarButton Icon="Delete" Label="Eliminar Página" Command="{x:Bind ViewModel.DeletePageCommand}" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarButton Icon="SaveLocal" Label="Guardar Como..." Command="{x:Bind ViewModel.SaveAsCommand}" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
        </CommandBar>

        <!-- Contenedor principal: Lista de miniaturas y vista previa -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista de miniaturas -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Páginas del documento" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Pages}"
                              SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PdfPageThumbnail">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="6">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Width="60" Height="80" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Image Source="{x:Bind ThumbnailImage}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind PageDisplay, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind RotationDisplay, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Vista detallada de la página seleccionada -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                Background="White" Padding="8" MaxWidth="700">
                            <Image Source="{x:Bind ViewModel.SelectedPage.ThumbnailImage, Mode=OneWay}"
                                   Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{x:Bind ViewModel.SelectedPage.RotationAngle, Mode=OneWay}" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Abre un archivo PDF para visualizar y editar sus páginas." Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra inferior de estado -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
