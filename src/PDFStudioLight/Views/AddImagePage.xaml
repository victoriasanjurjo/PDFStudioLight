<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PDFStudioLight.Views.AddImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Agregar Imagen o Sello a PDF" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Incrusta sellos gráficos, logos o imágenes con posición y dimensiones ajustables."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de Controles -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="16">
                    <!-- Selección de PDF -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Documento PDF" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PdfFileName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Button Content="Seleccionar PDF" Command="{x:Bind ViewModel.SelectPdfCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Selección de Imagen -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Imagen a Incrustar" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ImageFileName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Button Content="Seleccionar Imagen (PNG/JPG)" Command="{x:Bind ViewModel.SelectImageCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Parámetros de Incrustación -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Configuración de Posición y Tamaño" Style="{ThemeResource SubtitleTextBlockStyle}" />

                            <NumberBox Header="Página de Destino" Value="{x:Bind ViewModel.TargetPage, Mode=TwoWay}"
                                       Minimum="1" Maximum="{x:Bind ViewModel.MaxPages, Mode=OneWay}" SpinButtonPlacementMode="Inline" />

                            <TextBlock Text="Posición rápida (Presets):" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Abajo Der" Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="BottomRight" />
                                <Button Content="Abajo Izq" Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="BottomLeft" />
                                <Button Content="Centro" Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="Center" />
                                <Button Content="Arriba Der" Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="TopRight" />
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <NumberBox Grid.Row="0" Grid.Column="0" Header="Posición X (pt)" Value="{x:Bind ViewModel.PosX, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <NumberBox Grid.Row="0" Grid.Column="1" Header="Posición Y (pt)" Value="{x:Bind ViewModel.PosY, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <NumberBox Grid.Row="1" Grid.Column="0" Header="Ancho (pt)" Value="{x:Bind ViewModel.ImageWidth, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="Alto (pt)" Value="{x:Bind ViewModel.ImageHeight, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                            </Grid>

                            <Button Content="Incrustar y Guardar Como..."
                                    Command="{x:Bind ViewModel.ApplyAndSaveCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Previsualización de la Imagen -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                            <TextBlock Text="Vista previa del elemento a estampar" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16" MaxWidth="450" MaxHeight="350">
                                <Image Source="{x:Bind ViewModel.ImagePreview, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Estado -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
